<UserControl x:Class="CatGuard.CatMascot" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Height="250" Background="Transparent"
             MouseMove="OnMouseMove" MouseLeave="OnMouseLeave">
  <Viewbox Stretch="Uniform">
    <Canvas Width="330" Height="280">
      <!-- The keyboard and paws use the chunky, inked silhouette of the reference. -->
      <Ellipse Canvas.Left="47" Canvas.Top="239" Width="245" Height="25" Fill="#208DA0" Opacity="0.35"/>
      <Border Canvas.Left="55" Canvas.Top="215" Width="235" Height="44" Background="#FAF6F5"
              BorderBrush="#332D31" BorderThickness="3" CornerRadius="13">
        <UniformGrid Rows="1" Columns="8" Margin="11,8">
          <Border Background="#E2D7D5" CornerRadius="4" Margin="2"/>
          <Border Background="#E2D7D5" CornerRadius="4" Margin="2"/>
          <Border Background="#E2D7D5" CornerRadius="4" Margin="2"/>
          <Border Background="#FF94AB" CornerRadius="4" Margin="2"/>
          <Border Background="#E2D7D5" CornerRadius="4" Margin="2"/>
          <Border Background="#E2D7D5" CornerRadius="4" Margin="2"/>
          <Border Background="#E2D7D5" CornerRadius="4" Margin="2"/>
          <Border Background="#E2D7D5" CornerRadius="4" Margin="2"/>
        </UniformGrid>
      </Border>
      <Canvas x:Name="TailLayer" Canvas.Left="211" Canvas.Top="103" Width="91" Height="133" RenderTransformOrigin="0.14,0.9">
        <Canvas.RenderTransform><RotateTransform x:Name="TailRotate" Angle="-6"/></Canvas.RenderTransform>
        <Path Data="M 8,110 C 60,111 72,89 61,53 C 57,39 69,31 79,41 C 96,69 87,119 55,126 L 8,129 Z"
              Fill="#FAF6F5" Stroke="#332D31" StrokeThickness="3.5" StrokeLineJoin="Round"/>
        <Path Data="M 58,64 C 72,66 81,69 86,75" Stroke="#CFC2BF" StrokeThickness="11" StrokeStartLineCap="Round"/>
      </Canvas>
      <Canvas x:Name="BodyLayer" Canvas.Left="57" Canvas.Top="81" Width="218" Height="165" RenderTransformOrigin="0.5,1">
        <Canvas.RenderTransform><ScaleTransform x:Name="BodyScale" ScaleY="1"/></Canvas.RenderTransform>
        <Path Data="M 30,143 C 12,117 21,63 44,38 C 69,8 150,8 176,38 C 199,65 200,118 181,143 C 159,162 51,162 30,143 Z"
              Fill="#FAF6F5" Stroke="#332D31" StrokeThickness="3.5" StrokeLineJoin="Round"/>
        <Path Data="M 119,20 C 150,13 176,35 184,58 C 190,77 184,91 170,99 C 144,104 135,83 113,75 Z"
              Fill="#CFC2BF"/>
        <Path Data="M 55,130 C 62,114 79,117 84,132 M 136,132 C 143,116 162,114 169,133" Stroke="#332D31" StrokeThickness="3.5" StrokeStartLineCap="Round"/>
      </Canvas>
      <Canvas x:Name="HeadLayer" Canvas.Left="76" Canvas.Top="26" Width="180" Height="148" RenderTransformOrigin="0.5,0.7">
        <Canvas.RenderTransform><RotateTransform x:Name="HeadRotate" Angle="0"/></Canvas.RenderTransform>
        <!-- Two small overlapping ear folds give the Jianzhou cat a four-ear outline. -->
        <Path Data="M 28,58 L 32,8 L 70,37 M 111,37 L 149,8 L 153,58" Fill="#E2D7D5" Stroke="#332D31" StrokeThickness="3.5" StrokeLineJoin="Round"/>
        <Path Data="M 39,49 L 43,19 L 72,39 M 109,39 L 139,19 L 143,49" Fill="#FAF6F5" Stroke="#332D31" StrokeThickness="3" StrokeLineJoin="Round"/>
        <Path Data="M 31,50 C 48,29 132,28 151,51 C 171,73 164,121 144,135 C 117,151 67,152 37,135 C 12,117 11,76 31,50 Z"
              Fill="#FAF6F5" Stroke="#332D31" StrokeThickness="3.5" StrokeLineJoin="Round"/>
        <Path Data="M 91,37 C 123,35 145,42 151,57 C 143,73 136,79 119,76 C 107,68 97,69 90,57 Z" Fill="#CFC2BF"/>
        <Path Data="M 39,72 C 47,66 56,66 64,69 M 116,69 C 125,65 134,66 142,72" Stroke="#332D31" StrokeThickness="2.5" StrokeStartLineCap="Round"/>
        <Canvas x:Name="EyeLayer" RenderTransformOrigin="0.5,0.65" Canvas.Left="0" Canvas.Top="0" Width="180" Height="148">
          <Canvas.RenderTransform><ScaleTransform x:Name="EyeScale" ScaleY="1"/></Canvas.RenderTransform>
          <Ellipse Canvas.Left="53" Canvas.Top="78" Width="12" Height="16" Fill="#332D31"/>
          <Ellipse Canvas.Left="117" Canvas.Top="78" Width="12" Height="16" Fill="#332D31"/>
          <Ellipse Canvas.Left="57" Canvas.Top="80" Width="3" Height="4" Fill="White"/>
          <Ellipse Canvas.Left="121" Canvas.Top="80" Width="3" Height="4" Fill="White"/>
        </Canvas>
        <Path Data="M 85,99 L 97,99 L 91,106 Z" Fill="#FF94AB" Stroke="#332D31" StrokeThickness="2" StrokeLineJoin="Round"/>
        <Path Data="M 91,106 C 88,113 80,114 76,109 M 91,106 C 94,113 103,114 107,109" Stroke="#332D31" StrokeThickness="2.2" StrokeStartLineCap="Round"/>
        <Path Data="M 47,103 L 18,98 M 48,109 L 18,111 M 134,103 L 162,98 M 133,109 L 163,112" Stroke="#332D31" StrokeThickness="2" StrokeStartLineCap="Round"/>
        <Ellipse Canvas.Left="42" Canvas.Top="101" Width="18" Height="8" Fill="#FF94AB" Opacity="0.55"/>
        <Ellipse Canvas.Left="124" Canvas.Top="101" Width="18" Height="8" Fill="#FF94AB" Opacity="0.55"/>
      </Canvas>
      <Path Data="M 110,220 C 116,207 132,207 138,219 M 187,219 C 193,206 209,207 215,220" Stroke="#332D31" StrokeThickness="3.5" StrokeStartLineCap="Round"/>
    </Canvas>
  </Viewbox>
</UserControl>
