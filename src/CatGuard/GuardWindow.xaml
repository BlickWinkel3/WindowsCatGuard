<Window x:Class="CatGuard.GuardWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CatGuard"
        Width="1030" Height="870" MinWidth="940" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#FAF6F5"
        FontFamily="Microsoft YaHei UI" Foreground="#332D31" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#332D31"/>
    <SolidColorBrush x:Key="Aqua" Color="#56C4D4"/>
    <SolidColorBrush x:Key="Pink" Color="#FF94AB"/>
    <SolidColorBrush x:Key="Paper" Color="#FAF6F5"/>
    <SolidColorBrush x:Key="Taupe" Color="#E2D7D5"/>
    <SolidColorBrush x:Key="Muted" Color="#665C5D"/>
    <Style x:Key="Caps" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="{StaticResource Paper}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="17,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Frame" CornerRadius="21" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.82"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="RenderTransform"><Setter.Value><TranslateTransform Y="2"/></Setter.Value></Setter></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Option" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,6,0,6"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center"/>
            <Border x:Name="Track" Grid.Column="1" Width="38" Height="23" CornerRadius="12" Background="#CFC2BF" BorderBrush="{StaticResource Ink}" BorderThickness="1.5" HorizontalAlignment="Right">
              <Ellipse x:Name="Thumb" Width="15" Height="15" Fill="{StaticResource Paper}" Stroke="{StaticResource Ink}" StrokeThickness="1" HorizontalAlignment="Left" Margin="3,0,0,0"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource Pink}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Caps}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="CandySlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="7" CornerRadius="4" Background="#CFC2BF" VerticalAlignment="Center"/>
            <Track x:Name="PART_Track" VerticalAlignment="Center">
              <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="7" Background="{StaticResource Pink}" CornerRadius="4"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Width="19" Height="19"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource Pink}" Stroke="{StaticResource Ink}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
    <Grid MinWidth="900" Margin="29,24,29,23">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="352"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource Pink}" BorderBrush="{StaticResource Ink}" BorderThickness="2" Margin="0,0,11,0">
            <TextBlock Text="✿" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel><TextBlock Text="WindowsCatGuard" FontSize="23" FontWeight="Bold"/>
            <TextBlock x:Name="TaglineText" FontSize="12" Foreground="{StaticResource Muted}"/></StackPanel>
        </StackPanel>
        <TextBlock x:Name="VersionText" Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource Muted}" Margin="10,0,20,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12" FontWeight="Bold"/>
          <ComboBox x:Name="LanguageBox" Width="110" Height="32" FontSize="12" FontWeight="SemiBold" SelectionChanged="OnLanguageChanged">
            <ComboBoxItem Content="中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en"/>
          </ComboBox>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Grid.Column="0" CornerRadius="28" Background="{StaticResource Aqua}" BorderBrush="{StaticResource Ink}" BorderThickness="2" Padding="17,17,17,15">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid><TextBlock x:Name="CompanionText" Foreground="White" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="JianzhouText" HorizontalAlignment="Right" Foreground="White" FontSize="11" FontWeight="Bold"/></Grid>
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <Border Background="#68D0DE" CornerRadius="30" BorderBrush="#36A6B8" BorderThickness="1" Margin="0,12,0,10">
              <local:CatMascot x:Name="Mascot" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="CatNameText" HorizontalAlignment="Center" FontSize="25" FontWeight="Bold"/>
            <TextBlock x:Name="CatDescriptionText" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0"/>
            <TextBlock x:Name="CatHintText" HorizontalAlignment="Center" FontSize="11" Foreground="#35545B" Margin="0,9,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Border Height="1" Background="#80E9F0" Margin="0,10,0,9"/>
            <CheckBox x:Name="AnimationOption" Style="{StaticResource Option}" Click="OnAnimationChanged"/>
            <TextBlock x:Name="LocalOnlyText" FontSize="11" Foreground="#35545B" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Grid.Column="2">
        <Border Background="White" CornerRadius="24" BorderBrush="#E2D7D5" BorderThickness="1.5" Padding="21,12,21,13" Margin="0,0,0,10">
          <StackPanel>
            <TextBlock x:Name="ProtectionText" Style="{StaticResource Section}"/>
            <TextBlock x:Name="StatusText" FontSize="25" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatusDetailText" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,9"/>
            <StackPanel Orientation="Horizontal"><Button x:Name="ToggleButton" Style="{StaticResource PillButton}" Background="{StaticResource Pink}" Click="OnToggle" Margin="0,0,8,0"/>
              <Button x:Name="UnlockButton" Style="{StaticResource PillButton}" Click="OnUnlock"/></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="Ctrl + Alt + L" FontSize="11" FontWeight="Bold"/><TextBlock x:Name="MouseText" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,0" TextWrapping="Wrap"/></StackPanel>
            <UniformGrid Columns="3" Margin="0,11,0,0">
              <Border Background="#FAF6F5" CornerRadius="10" Margin="0,0,5,0" Padding="9,6"><StackPanel><TextBlock x:Name="TriggersLabel" Style="{StaticResource Caps}"/><TextBlock x:Name="TriggersNumber" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
              <Border Background="#FAF6F5" CornerRadius="10" Margin="2,0,3,0" Padding="9,6"><StackPanel><TextBlock x:Name="HeldLabel" Style="{StaticResource Caps}"/><TextBlock x:Name="HeldNumber" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
              <Border Background="#FAF6F5" CornerRadius="10" Margin="5,0,0,0" Padding="9,6"><StackPanel><TextBlock x:Name="BlockedLabel" Style="{StaticResource Caps}"/><TextBlock x:Name="BlockedNumber" FontSize="18" FontWeight="Bold"/></StackPanel></Border>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Background="#F2ECEA" CornerRadius="24" BorderBrush="#E2D7D5" BorderThickness="1.5" Padding="21,11,21,9">
          <StackPanel>
            <TextBlock x:Name="SettingsText" Style="{StaticResource Section}" Margin="0,0,0,5"/>
            <CheckBox x:Name="EnabledOption" Style="{StaticResource Option}" Click="OnOptionsChanged"/>
            <TextBlock x:Name="EnabledHintText" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,-4,0,2" TextWrapping="Wrap"/>
            <CheckBox x:Name="WarnOption" Style="{StaticResource Option}" Click="OnOptionsChanged"/>
            <TextBlock x:Name="WarnHintText" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,-4,0,8" TextWrapping="Wrap"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="SensitivityText" Style="{StaticResource Section}"/>
              <TextBlock x:Name="SensitivityValue" Grid.Column="1" FontSize="12" FontWeight="Bold"/>
            </Grid>
            <Slider x:Name="SensitivitySlider" Style="{StaticResource CandySlider}" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="2,6,2,0" ValueChanged="OnOptionsChanged"/>
            <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="LessText" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MoreText" Grid.Column="1" FontSize="10" Foreground="{StaticResource Muted}"/></Grid>
            <CheckBox x:Name="StayOption" Style="{StaticResource Option}" Click="OnOptionsChanged"/>
            <CheckBox x:Name="SoundOption" Style="{StaticResource Option}" Click="OnOptionsChanged"/>
            <CheckBox x:Name="StartupOption" Style="{StaticResource Option}" Click="OnStartupChanged"/>
            <TextBlock x:Name="StartupHintText" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,-4,0,0"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,17,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="TestText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="LimitText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#A43852" TextWrapping="Wrap"/>
          <Expander x:Name="DiagnosticsBox" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource Muted}">
            <StackPanel><TextBlock x:Name="PhysicalText"/><TextBlock x:Name="InjectedText"/><TextBlock x:Name="ReasonText"/></StackPanel>
          </Expander>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="12,0,0,0">
          <Button x:Name="HideButton" Style="{StaticResource PillButton}" Padding="12,6" BorderThickness="1.5" Click="OnHide" Margin="0,0,7,0"/>
          <Button x:Name="ExitButton" Style="{StaticResource PillButton}" Padding="12,6" BorderThickness="1.5" Click="OnExit"/>
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</Window>
