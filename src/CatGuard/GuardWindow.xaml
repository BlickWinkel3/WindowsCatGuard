<Window x:Class="CatGuard.GuardWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="510" Height="690" MinWidth="460" MinHeight="550" MaxWidth="570"
        Icon="/assets/paw.ico" WindowStartupLocation="CenterScreen"
        Background="#F8F7FC" Foreground="#242735" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#242735"/>
    <SolidColorBrush x:Key="Muted" Color="#747888"/>
    <SolidColorBrush x:Key="Lilac" Color="#E8DFF3"/>
    <SolidColorBrush x:Key="LilacStrong" Color="#BDA7DE"/>
    <SolidColorBrush x:Key="Mint" Color="#DDF0EC"/>
    <SolidColorBrush x:Key="Butter" Color="#FFF0BF"/>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Muted}"/>
    </Style>
    <Style x:Key="SoftButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="Background" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Shape" CornerRadius="16" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Shape" Property="Opacity" Value="0.78"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Shape" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Shape" Property="Opacity" Value="0.43"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="LanguageTab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
        <Border x:Name="Tab" Background="Transparent" CornerRadius="10" Padding="10,7">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tab" Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource Ink}"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tab" Property="Opacity" Value="0.7"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SwitchOption" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,6,0,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
          <ContentPresenter VerticalAlignment="Center"/>
          <Border x:Name="Track" Grid.Column="1" Width="36" Height="22" CornerRadius="11" Background="#D8D9E0" HorizontalAlignment="Right">
            <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#9277C6"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SoftSlider" TargetType="Slider">
      <Setter Property="Height" Value="22"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
        <Grid VerticalAlignment="Center">
          <Border Height="7" CornerRadius="4" Background="#E8E7EF" VerticalAlignment="Center"/>
          <Track x:Name="PART_Track" VerticalAlignment="Center">
            <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="7" Background="#BDA7DE" CornerRadius="4"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="#9277C6" StrokeThickness="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="22,20,22,20" MinWidth="410">
      <Grid Margin="0,0,0,17">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="43" Height="43" CornerRadius="14" Background="{StaticResource Lilac}" Margin="0,0,11,0">
          <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Width="48" Height="48">
              <Ellipse Canvas.Left="14" Canvas.Top="22" Width="25" Height="20" Fill="{StaticResource Ink}"/>
              <Ellipse Canvas.Left="2" Canvas.Top="16" Width="9" Height="12" Fill="{StaticResource Ink}"/>
              <Ellipse Canvas.Left="11" Canvas.Top="4" Width="9" Height="13" Fill="{StaticResource Ink}"/>
              <Ellipse Canvas.Left="26" Canvas.Top="3" Width="9" Height="13" Fill="{StaticResource Ink}"/>
              <Ellipse Canvas.Left="39" Canvas.Top="14" Width="8" Height="12" Fill="{StaticResource Ink}"/>
            </Canvas>
          </Viewbox>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="WindowsCatGuard" FontSize="18" FontWeight="Bold"/>
          <TextBlock x:Name="TaglineText" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel>
        <Border Grid.Column="2" Background="#ECEAF2" CornerRadius="12" Padding="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ChineseButton" Style="{StaticResource LanguageTab}" Content="中文" GroupName="Language" Click="OnLanguageClicked" Tag="zh-CN"/>
            <RadioButton x:Name="EnglishButton" Style="{StaticResource LanguageTab}" Content="EN" GroupName="Language" Click="OnLanguageClicked" Tag="en"/>
          </StackPanel>
        </Border>
      </Grid>
      <Border Background="{StaticResource Lilac}" CornerRadius="23" Padding="20,17,20,17" Margin="0,0,0,11">
        <StackPanel>
          <Grid><TextBlock x:Name="ProtectionText" Style="{StaticResource SectionLabel}" Foreground="#685B7C"/>
            <TextBlock x:Name="VersionText" HorizontalAlignment="Right" FontSize="10" Foreground="#80738E"/></Grid>
          <TextBlock x:Name="StatusText" FontSize="26" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="StatusDetailText" FontSize="12" Foreground="#5F6071" TextWrapping="Wrap" Margin="0,4,0,12"/>
          <StackPanel Orientation="Horizontal"><Button x:Name="ToggleButton" Style="{StaticResource SoftButton}" Background="{StaticResource Ink}" Foreground="White" Click="OnToggle" Margin="0,0,8,0"/>
            <Button x:Name="UnlockButton" Style="{StaticResource SoftButton}" Click="OnUnlock"/></StackPanel>
          <TextBlock x:Name="MouseText" FontSize="11" Foreground="#685B7C" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>
      <UniformGrid Columns="3" Margin="0,0,0,11">
        <Border Background="{StaticResource Mint}" CornerRadius="17" Padding="12,10" Margin="0,0,4,0"><StackPanel><TextBlock x:Name="TriggersLabel" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="TriggersNumber" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
        <Border Background="{StaticResource Butter}" CornerRadius="17" Padding="12,10" Margin="4,0,4,0"><StackPanel><TextBlock x:Name="HeldLabel" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="HeldNumber" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
        <Border Background="#E9E3F4" CornerRadius="17" Padding="12,10" Margin="4,0,0,0"><StackPanel><TextBlock x:Name="BlockedLabel" Style="{StaticResource SectionLabel}"/><TextBlock x:Name="BlockedNumber" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
      </UniformGrid>
      <Border Background="White" CornerRadius="23" Padding="19,15,19,14">
        <StackPanel>
          <TextBlock x:Name="SettingsText" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
          <Border Background="{StaticResource Mint}" CornerRadius="15" Padding="12,8" Margin="0,0,0,6">
            <StackPanel><CheckBox x:Name="EnabledOption" Style="{StaticResource SwitchOption}" Click="OnOptionsChanged"/>
              <TextBlock x:Name="EnabledHintText" FontSize="11" Foreground="#60756F" TextWrapping="Wrap" Margin="0,-2,30,0"/></StackPanel>
          </Border>
          <Border Background="#F7F6FA" CornerRadius="15" Padding="12,6" Margin="0,0,0,10">
            <CheckBox x:Name="WarnOption" Style="{StaticResource SwitchOption}" Click="OnOptionsChanged"/>
          </Border>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SensitivityText" FontWeight="SemiBold"/><TextBlock x:Name="SensitivityValue" Grid.Column="1" FontWeight="Bold"/></Grid>
          <Slider x:Name="SensitivitySlider" Style="{StaticResource SoftSlider}" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,5,0,0" ValueChanged="OnOptionsChanged"/>
          <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="LessText" FontSize="10" Foreground="{StaticResource Muted}"/><TextBlock x:Name="MoreText" Grid.Column="1" FontSize="10" Foreground="{StaticResource Muted}"/></Grid>
          <Expander x:Name="AdvancedBox" Margin="0,8,0,0" Foreground="{StaticResource Ink}">
            <StackPanel Margin="1,8,0,0">
              <TextBlock x:Name="WarnHintText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
              <CheckBox x:Name="StayOption" Style="{StaticResource SwitchOption}" Click="OnOptionsChanged"/>
              <CheckBox x:Name="SoundOption" Style="{StaticResource SwitchOption}" Click="OnOptionsChanged"/>
              <CheckBox x:Name="StartupOption" Style="{StaticResource SwitchOption}" Click="OnStartupChanged"/>
              <TextBlock x:Name="StartupHintText" FontSize="11" Foreground="{StaticResource Muted}"/>
              <TextBlock x:Name="TestText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
              <TextBlock x:Name="LimitText" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              <Expander x:Name="DiagnosticsBox" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource Muted}">
                <StackPanel><TextBlock x:Name="PhysicalText"/><TextBlock x:Name="InjectedText"/><TextBlock x:Name="ReasonText"/></StackPanel>
              </Expander>
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
      <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#A34E72" TextWrapping="Wrap" Margin="3,8,3,0"/>
      <Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Ctrl + Alt + L" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <Button x:Name="HideButton" Grid.Column="1" Style="{StaticResource SoftButton}" Padding="10,7" Background="Transparent" Click="OnHide"/>
        <Button x:Name="ExitButton" Grid.Column="2" Style="{StaticResource SoftButton}" Padding="10,7" Background="Transparent" Click="OnExit"/>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Window>
